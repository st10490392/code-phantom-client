rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for downloadable client builds
    match /downloads/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    // Everything else locked down
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
